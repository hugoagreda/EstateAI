# ---------------------------------------------------------------------------
# EstateAI — environment
# ---------------------------------------------------------------------------
# MODE controls the whole app:
#   mock -> 100% offline. Lexical retrieval over data/chunks.json + templated
#           answer. NO OpenAI, NO Supabase, NO network. Use this on the plane.
#   live -> real RAG. OpenAI embeddings + Supabase pgvector + gpt-4o-mini.
# ⚠️ Default is mock so the app builds & runs with zero secrets.
ESTATEAI_MODE=mock

# --- Only needed when ESTATEAI_MODE=live ---
OPENAI_API_KEY=
# Supabase project (pgvector enabled). See supabase/schema.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Rate limiting (applies in both modes) ---
# Per-IP messages allowed per hour, and a global hard daily cap on LLM calls.
RATELIMIT_PER_IP_PER_HOUR=8
RATELIMIT_GLOBAL_DAILY=500
# Max characters accepted from a single user message.
MAX_INPUT_CHARS=500
